# ---------------------------------------------------------------------------
# AI Order Supervisor Docker environment
# Copy this file to .env before running docker compose.
# ---------------------------------------------------------------------------

# Image tags
APP_IMAGE_TAG=local
TEMPORAL_IMAGE_TAG=1.29.1
TEMPORAL_UI_IMAGE_TAG=2.49.1

# Host ports
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_HOST_PORT=5432
TEMPORAL_BIND_ADDR=127.0.0.1
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_BIND_ADDR=127.0.0.1
TEMPORAL_UI_HOST_PORT=8233
BACKEND_BIND_ADDR=127.0.0.1
BACKEND_HOST_PORT=8000
FRONTEND_BIND_ADDR=127.0.0.1
FRONTEND_HOST_PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=order_supervisor
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/order_supervisor
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# Temporal
TEMPORAL_TARGET_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_CLIENT_CERT=
TEMPORAL_TLS_CLIENT_KEY=
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000

# Worker tuning
WORKER_MAX_CONCURRENT_ACTIVITIES=40
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=100

# FastAPI / browser access
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend
# Browser-side URL. Because this is compiled into the Next.js client bundle,
# rebuild the frontend image after changing it:
#   docker compose build frontend && docker compose up -d frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local LLM / OpenAI-compatible model endpoint.
# For Ollama running on the host machine, keep this URL when using Docker.
# If you run the backend outside Docker, use http://localhost:11434/v1 instead.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
